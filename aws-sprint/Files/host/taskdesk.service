[Unit]
Description=TaskDesk single-host Docker application
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/taskdesk
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
UMask=0077
ExecStartPre=/usr/bin/mountpoint -q /srv/taskdesk
ExecStart=/usr/local/sbin/taskdesk-launch start
ExecStop=-/usr/bin/docker stop --time 60 REPLACE_ACTUAL_APP_CONTAINER
Restart=always
RestartSec=15
TimeoutStopSec=120
StandardOutput=append:/var/log/taskdesk/service.log
StandardError=append:/var/log/taskdesk/service.log

[Install]
WantedBy=multi-user.target
