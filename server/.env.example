# Copy to .env and fill in. Never commit .env.
# Used only the first time the server starts (when there are no users yet):
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisPassword!

# Email (Zoho): welcome emails, "Forgot password?" and notification emails. Leave SMTP_PASS empty to turn email off.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskDesk <taskdesk@yourcompany.com>
# The address people open TaskDesk at; used for every link in emails.
APP_URL=http://192.168.1.222:3000
