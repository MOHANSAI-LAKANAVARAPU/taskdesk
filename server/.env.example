# Copy to .env and fill in. Never commit .env.
# Used only the first time the server starts (when there are no users yet):
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisPassword!

# Email (Zoho): welcome emails, "Forgot password?" and notification emails. Leave SMTP_PASS empty to turn email off.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskDesk <taskdesk@yourcompany.com>
# The address people open TaskDesk at; used for every link in emails.
APP_URL=http://192.168.1.222:3000

# Largest file people can upload (each file, in MB). Any file type is allowed.
MAX_UPLOAD_MB=50

# The owner account: the email of an active admin. Nobody else can change, remove or demote it.
# Ownership moves only with scripts/transfer-owner.sh. If it matches no active admin, nobody is treated as owner.
OWNER_EMAIL=owner@yourcompany.com

# Email pace (Scale). EMAIL_PER_MINUTE: the most emails a minute, for all email (default 10).
# EMAIL_WELCOME_PER_DAY: the most welcome emails sent in any 24 hours after a bulk import (default 400, 0 = no cap).
# Zoho's limits depend on your plan; if it says a limit was reached, TaskDesk pauses all email for an hour.
#EMAIL_PER_MINUTE=10
#EMAIL_WELCOME_PER_DAY=400

# Read-only mode (write freeze) for the move to a new server. Normally turned on and off by an admin on the Account page
# ("Read-only mode"); this setting forces it on (the page cannot turn it off; remove it and restart). MAINTENANCE_UNTIL is the
# time shown to everyone, e.g. 2026-11-07T18:30:00+05:30.
#MAINTENANCE=readonly
#MAINTENANCE_UNTIL=
